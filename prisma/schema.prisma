generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum UserRole { 
  PLAYER
  ADMIN
  OWNER
}
enum UserStatus {
  ACTIVE
  BANNED
}
enum RoomStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum GameActionType {
  ROOM_CREATED
  ROOM_JOINED
  PLAYER_READY
  GAME_STARTED
  QUESTION_ASKED
  GUESS_MADE
  PLAYER_LEFT
  GAME_FINISHED
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  role UserRole @default(PLAYER)
  status UserStatus @default(ACTIVE)
  isGuest Boolean @default(false)
  accounts Account[]
  sessions Session[]
  hostedRooms Room[] @relation("RoomHost")
  wonRooms Room[] @relation("RoomWinner")
  roomMemberships RoomMember[]
  gameActions GameAction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role,status])
  @@index([createdAt])
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([provider,providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model SiteSettings {
  id String @id @default("global")
  siteNameAr String @default("ساحة التخمين")
  siteNameEn String @default("Guess Arena")
  defaultLocale String @default("ar")
  availableLocales String[] @default(["ar","en"])
  allowGuestAccess Boolean @default(true)
  maxPlayersPerRoom Int @default(2)
  turnTimerSeconds Int @default(60)
  gameDurationSeconds Int @default(900)
  maintenanceMode Boolean @default(false)
  primaryColor String @default("#7257E8")
  secondaryColor String @default("#37CDB0")
  socialLinks Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Room {
  id String @id @default(cuid())
  code String @unique
  status RoomStatus @default(WAITING)
  hostId String
  winnerId String?
  currentTurnUserId String?
  turnNumber Int @default(0)
  version Int @default(0)
  maxPlayers Int @default(2)
  expiresAt DateTime?
  turnExpiresAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  host User @relation("RoomHost",fields:[hostId],references:[id],onDelete:Restrict)
  winner User? @relation("RoomWinner",fields:[winnerId],references:[id],onDelete:SetNull)
  members RoomMember[]
  actions GameAction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,expiresAt])
  @@index([hostId,createdAt])
}
model RoomMember {
  id String @id @default(cuid())
  roomId String
  userId String
  seat Int
  isReady Boolean @default(false)
  isConnected Boolean @default(true)
  secretCharacterId String?
  eliminatedCharacterIds String[] @default([])
  lastSeenAt DateTime @default(now())
  joinedAt DateTime @default(now())
  leftAt DateTime?
  room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([roomId,userId])
  @@unique([roomId,seat])
  @@index([userId,isConnected])
}
model GameAction {
  id String @id @default(cuid())
  roomId String
  actorId String
  sequence Int
  type GameActionType
  idempotencyKey String
  payload Json
  room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@unique([roomId,sequence])
  @@unique([roomId,actorId,idempotencyKey])
  @@index([roomId,createdAt])
}
