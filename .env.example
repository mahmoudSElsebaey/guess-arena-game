# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Ably (server-side only; never expose this key to the browser)
ABLY_API_KEY=""

# Cloudinary (Phase 2+ character asset management)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo accounts are disabled unless explicitly enabled.
DEMO_ACCOUNTS_ENABLED="false"

# Private staff demo accounts. Keep these values server-side only.
DEMO_OWNER_EMAIL=""
DEMO_OWNER_PASSWORD=""
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""

# Public player demo accounts are intentionally visible on the login page.
NEXT_PUBLIC_DEMO_PLAYER_ONE_EMAIL=""
NEXT_PUBLIC_DEMO_PLAYER_ONE_PASSWORD=""
NEXT_PUBLIC_DEMO_PLAYER_TWO_EMAIL=""
NEXT_PUBLIC_DEMO_PLAYER_TWO_PASSWORD=""
